# ==============================================================================
# Database Configuration (Neon PostgreSQL & Render Production Setup)
# ==============================================================================

# Priority 1: Primary production database connection string (used by Render / Neon)
# Example (Neon Direct): postgresql+psycopg://user:pass@ep-cool-name.us-east-2.aws.neon.tech/neondb?sslmode=require
# Example (Neon Pooled): postgresql+psycopg://user:pass@ep-cool-name-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql+psycopg://postgres:1234@localhost:5432/quant_research

# Priority 2: Discrete PostgreSQL Parameters (Used if DATABASE_URL is not set)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=quant_research
POSTGRES_USER=postgres
POSTGRES_PASSWORD=1234

# Driver & Connection Pool Settings
DB_DRIVER=psycopg
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=300
DB_POOL_TIMEOUT=30
DB_POOL_PRE_PING=true
DB_SSL_MODE=require

# Neon Connection Mode: 'auto', 'pooled', or 'direct'
DB_NEON_POOLED_MODE=auto

# Diagnostics & Logging
DB_ENABLE_EVENT_LOGGING=false

# External API Keys
FRED_API_KEY=your_fred_api_key_here
