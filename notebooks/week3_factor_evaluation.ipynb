{
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Week 3 Factor Evaluation Report\n",
    "This notebook loads the computed factor scores, returns, and evaluation metrics from the database and plots diagnostic charts for each of the 5 base factors."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "from sqlalchemy import text\n",
    "from src.data.db import get_engine\n",
    "\n",
    "%matplotlib inline\n",
    "sns.set_theme(style='whitegrid')\n",
    "engine = get_engine()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. Load Evaluation Summary"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Load overall evaluation summary from DB\n",
    "query = text(\"\"\"\n",
    "    SELECT factor_name, stage, metric_name, value \n",
    "    FROM factor_metrics \n",
    "    WHERE date = (SELECT MAX(date) FROM factor_metrics)\n",
    "      AND metric_name IN ('ic_mean', 'ic_std', 'icir', 'sharpe_q1', 'sharpe_q5', 'sharpe_ls', 'half_life')\n",
    "\"\"\")\n",
    "with engine.connect() as conn:\n",
    "    summary_df = pd.read_sql(query, conn)\n",
    "\n",
    "pivot_summary = summary_df.pivot(index=['factor_name', 'stage'], columns='metric_name', values='value')\n",
    "pivot_summary"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. Information Coefficient (IC) Analysis"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Load historical rolling IC\n",
    "query = text(\"\"\"\n",
    "    SELECT date, factor_name, stage, value as ic \n",
    "    FROM factor_metrics \n",
    "    WHERE metric_name = 'ic'\n",
    "    ORDER BY date, factor_name, stage\n",
    "\"\"\")\n",
    "with engine.connect() as conn:\n",
    "    ic_df = pd.read_sql(query, conn)\n",
    "ic_df['date'] = pd.to_datetime(ic_df['date'])\n",
    "\n",
    "# Plot IC timeseries for each factor\n",
    "for factor_name, group in ic_df.groupby('factor_name'):\n",
    "    plt.figure(figsize=(12, 5))\n",
    "    for stage, sub_group in group.groupby('stage'):\n",
    "        sub_group_sorted = sub_group.sort_values('date')\n",
    "        plt.plot(sub_group_sorted['date'], sub_group_sorted['ic'], label=f'{stage} IC', alpha=0.7)\n",
    "        # Plot rolling 12-month mean\n",
    "        rolling_mean = sub_group_sorted.set_index('date')['ic'].rolling(12, min_periods=1).mean()\n",
    "        plt.plot(rolling_mean.index, rolling_mean, linestyle='--', label=f'{stage} IC (12M Rolling Mean)', alpha=0.9)\n",
    "    \n",
    "    plt.title(f'Spearman Rank IC over Time - {factor_name}')\n",
    "    plt.ylabel('IC')\n",
    "    plt.legend()\n",
    "    plt.tight_layout()\n",
    "    plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. Quintile Portfolio Cumulative Performance"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Load quintile returns\n",
    "query = text(\"\"\"\n",
    "    SELECT date, factor_name, stage, metric_name, value \n",
    "    FROM factor_metrics \n",
    "    WHERE metric_name IN ('return_q1', 'return_q5', 'return_ls')\n",
    "    ORDER BY date\n",
    "\"\"\")\n",
    "with engine.connect() as conn:\n",
    "    ret_df = pd.read_sql(query, conn)\n",
    "ret_df['date'] = pd.to_datetime(ret_df['date'])\n",
    "\n",
    "for (factor_name, stage), group in ret_df.groupby(['factor_name', 'stage']):\n",
    "    pivot_ret = group.pivot(index='date', columns='metric_name', values='value').sort_index()\n",
    "    # Calculate cumulative simple returns\n",
    "    cum_returns = (1 + pivot_ret).cumprod() - 1\n",
    "    \n",
    "    plt.figure(figsize=(10, 5))\n",
    "    plt.plot(cum_returns.index, cum_returns['return_q5'], label='Q5 (Top 20% Long)')\n",
    "    plt.plot(cum_returns.index, cum_returns['return_q1'], label='Q1 (Bottom 20% Short)')\n",
    "    plt.plot(cum_returns.index, cum_returns['return_ls'], label='Long-Short (Q5 - Q1)', linestyle=':')\n",
    "    plt.title(f'Quintile Cumulative Returns - {factor_name} ({stage})')\n",
    "    plt.ylabel('Cumulative Return')\n",
    "    plt.legend()\n",
    "    plt.tight_layout()\n",
    "    plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. Factor Autocorrelation Decay"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Load average autocorrelation values\n",
    "query = text(\"\"\"\n",
    "    SELECT factor_name, stage, metric_name, value \n",
    "    FROM factor_metrics \n",
    "    WHERE metric_name LIKE 'autocorr_lag%'\n",
    "      AND date = (SELECT MAX(date) FROM factor_metrics)\n",
    "\"\"\")\n",
    "with engine.connect() as conn:\n",
    "    decay_df = pd.read_sql(query, conn)\n",
    "\n",
    "decay_df['lag'] = decay_df['metric_name'].str.extract('(\\\d+)').astype(int)\n",
    "\n",
    "plt.figure(figsize=(10, 5))\n",
    "for (factor_name, stage), group in decay_df.groupby(['factor_name', 'stage']):\n",
    "    group_sorted = group.sort_values('lag')\n",
    "    plt.plot(group_sorted['lag'], group_sorted['value'], marker='o', label=f'{factor_name} ({stage})')\n",
    "\n",
    "plt.title('Factor Autocorrelation Decay Across Monthly Lags')\n",
    "plt.xlabel('Lag (Months)')\n",
    "plt.ylabel('Spearman Rank Autocorrelation')\n",
    "plt.legend(bbox_to_anchor=(1.05, 1), loc='upper left')\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  }
 ],
